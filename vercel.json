{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/frontend/index.html", "destination": "/index.html" },
    { "source": "/frontend/style.css", "destination": "/style.css" },
    { "source": "/frontend/script.js", "destination": "/script.js" },
    { "source": "/frontend/(.*)", "destination": "/$1" }
  ]
}
